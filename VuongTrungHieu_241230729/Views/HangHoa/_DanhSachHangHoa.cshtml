@model IEnumerable<VuongTrungHieu_241230729.Models.HangHoa>
@if (!Model.Any())
{
    <p>Không có hàng hóa phù hợp.</p>
}
else
{
    <div class="section group">
        @foreach (var item in Model)
        {
            var imagePath = string.IsNullOrWhiteSpace(item.Anh)
                ? Url.Content("~/Content/images/Img_1.jpg")
                : Url.Content("~/Content/images/uploads/" + item.Anh);
            if (!System.IO.File.Exists(System.IO.Path.Combine(
                System.IO.Directory.GetCurrentDirectory(), "wwwroot", "Content", "images", "uploads", item.Anh ?? "")))
            {
                imagePath = Url.Content("~/Content/images/" + (item.Anh ?? "Img_1.jpg"));
            }
            <div class="grid_1_of_4 images_1_of_4">
                <a href="#"><img src="@imagePath" alt="@item.TenHang" /></a>
                <h2>@item.TenHang</h2>
                <p class="product-category">@item.LoaiHang?.TenLoai</p>
                <div class="price-details">
                    <div class="price-number">
                        <p><span class="rupees">@((item.Gia ?? 0).ToString("N0"))</span></p>
                    </div>
                    <div class="clear"></div>
                </div>
            </div>
        }
    </div>
}
